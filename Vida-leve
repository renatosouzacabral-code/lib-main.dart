class UserProfile {
  String id; String name; double height; double initialWeight; double goalWeight; int age;
  UserProfile({required this.id, required this.name, required this.height, required this.initialWeight, required this.goalWeight, required this.age});
  Map<String, dynamic> toJson() => {'id': id, 'name': name, 'height': height, 'initialWeight': initialWeight, 'goalWeight': goalWeight, 'age': age};
  factory UserProfile.fromJson(Map<String, dynamic> json) => UserProfile(id: json['id'], name: json['name'], height: (json['height']?? 1.75).toDouble(), initialWeight: (json['initialWeight']?? 90).toDouble(), goalWeight: (json['goalWeight']?? 75).toDouble(), age: json['age']?? 30);
}
class WeightRecord {
  double weight; DateTime date;
  WeightRecord({required this.weight, required this.date});
  Map<String, dynamic> toJson() => {'weight': weight, 'date': date.toIso8601String()};
  factory WeightRecord.fromJson(Map<String, dynamic> json) => WeightRecord(weight: (json['weight']?? 0).toDouble(), date: DateTime.parse(json['date']));
}
