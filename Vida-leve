// BANCO LOCAL
class LocalStore {
  static const profilesKey = 'profiles'; static const recordsPrefix = 'records_'; static const favoriteKey = 'favorites';
  static Future<List<UserProfile>> getProfiles() async { final prefs = await SharedPreferences.getInstance(); final data = prefs.getStringList(profilesKey)?? []; return data.map((e) => UserProfile.fromJson(jsonDecode(e))).toList(); }
  static Future<void> saveProfiles(List<UserProfile> profiles) async { final prefs = await SharedPreferences.getInstance(); await prefs.setStringList(profilesKey, profiles.map((e) => jsonEncode(e.toJson())).toList()); }
  static Future<List<WeightRecord>> getRecords(String profileId) async { final prefs = await SharedPreferences.getInstance(); final data = prefs.getStringList('$recordsPrefix$profileId')?? []; return data.map((e) => WeightRecord.fromJson(jsonDecode(e))).toList(); }
  static Future<void> saveRecords(String profileId, List<WeightRecord> records) async { final prefs = await SharedPreferences.getInstance(); await prefs.setStringList('$recordsPrefix$profileId', records.map((e) => jsonEncode(e.toJson())).toList()); }
  static Future<Set<String>> getFavorites() async { final prefs = await SharedPreferences.getInstance(); return (prefs.getStringList(favoriteKey)?? []).toSet(); }
  static Future<void> saveFavorites(Set<String> favorites) async { final prefs = await SharedPreferences.getInstance(); await prefs.setStringList(favoriteKey, favorites.toList()); }
}

// APP PRINCIPAL
class AppScreen extends StatefulWidget { const AppScreen({super.key}); @override State<AppScreen> createState() => _AppScreenState(); }
class _AppScreenState extends State<AppScreen> {
  int selectedIndex = 0; List<UserProfile> profiles = []; UserProfile? currentProfile;
  @override void initState() { super.initState(); loadData(); }
  Future<void> loadData() async {
    final loaded = await LocalStore.getProfiles();
    if (loaded.isEmpty) {
      final profile = UserProfile(id: DateTime.now().millisecondsSinceEpoch.toString(), name: 'Meu Perfil', height: 1.75, initialWeight: 92.45, goalWeight: 75, age: 30);
      profiles = [profile]; currentProfile = profile;
      await LocalStore.saveProfiles(profiles);
      await LocalStore.saveRecords(profile.id, [WeightRecord(weight: 92.45, date: DateTime.now())]);
    } else { profiles = loaded; currentProfile = profiles.first; }
    if (mounted) setState(() {});
  }
  void selectProfile(UserProfile profile) { setState(() => currentProfile = profile); }
  @override Widget build(BuildContext context) {
    if (currentProfile == null) return const Scaffold(body: Center(child: CircularProgressIndicator()));
    final pages = [HomePage(profile: currentProfile!), ScalePage(profile: currentProfile!), RecipesPage(profile: currentProfile!), ProfilesPage(profiles: profiles, currentProfile: currentProfile!, onSelect: selectProfile, onProfilesChanged: (updated) { setState(() { profiles = updated; currentProfile = updated.firstWhere((p) => p.id == currentProfile!.id, orElse: () => updated.first); }); })];
    return Scaffold(body: pages[selectedIndex], bottomNavigationBar: NavigationBar(selectedIndex: selectedIndex, onDestinationSelected: (i) => setState(() => selectedIndex = i), destinations: const [NavigationDestination(icon: Icon(Icons.home_outlined), selectedIcon: Icon(Icons.home), label: 'Início'), NavigationDestination(icon: Icon(Icons.bluetooth_outlined), selectedIcon: Icon(Icons.bluetooth), label: 'Balança'), NavigationDestination(icon: Icon(Icons.restaurant_outlined), selectedIcon: Icon(Icons.restaurant), label: 'Receitas'), NavigationDestination(icon: Icon(Icons.person_outline), selectedIcon: Icon(Icons.person), label: 'Perfis')]));
  }
}

// HOME
class HomePage extends StatefulWidget { final UserProfile profile; const HomePage({super.key, required this.profile}); @override State<HomePage> createState() => _HomePageState(); }
class _HomePageState extends State<HomePage> {
  List<WeightRecord> records = [];
  @override void initState() { super.initState(); loadRecords(); }
  @override void didUpdateWidget(covariant HomePage oldWidget) { super.didUpdateWidget(oldWidget); if (oldWidget.profile.id!= widget.profile.id) loadRecords(); }
  Future<void> loadRecords() async { records = await LocalStore.getRecords(widget.profile.id); records.sort((a, b) => a.date.compareTo(b.date)); if (mounted) setState(() {}); }
  double get currentWeight => records.isEmpty? widget.profile.initialWeight : records.last.weight;
  double get bmi => widget.profile.height <= 0? 0 : currentWeight / (widget.profile.height * widget.profile.height);
  double get progress { final start = widget.profile.initialWeight; final goal = widget.profile.goalWeight; if (start == goal) return 1; final value = (start - currentWeight).abs() / (start - goal).abs(); return value.clamp(0.0, 1.0); }
  @override Widget build(BuildContext context) {
    return SafeArea(child: RefreshIndicator(onRefresh: loadRecords, child: ListView(padding: const EdgeInsets.all(20), children: [
      Text('Olá, ${widget.profile.name}! 👋', style: const TextStyle(fontSize: 26, fontWeight: FontWeight.bold)), const SizedBox(height: 5), Text('Vamos continuar o teu objetivo.', style: TextStyle(color: Colors.grey.shade600)), const SizedBox(height: 22),
      _MainWeightCard(weight: currentWeight, goal: widget.profile.goalWeight, progress: progress),
      const SizedBox(height: 14), Row(children: [Expanded(child: _InfoCard(title: 'IMC', value: bmi.toStringAsFixed(1), icon: Icons.monitor_weight, color: Colors.blue)), const SizedBox(width: 12), Expanded(child: _InfoCard(title: 'Meta', value: '${widget.profile.goalWeight.toStringAsFixed(1)} kg', icon: Icons.flag, color: Colors.green))]),
      const SizedBox(height: 24), const Text('Evolução', style: TextStyle(fontSize: 21, fontWeight: FontWeight.bold)), const SizedBox(height: 12), WeightChart(records: records),
      const SizedBox(height: 24), const Text('Últimas pesagens', style: TextStyle(fontSize: 21, fontWeight: FontWeight.bold)), const SizedBox(height: 10),
      if (records.isEmpty) const Text('Ainda não existem pesagens.') else...records.reversed.take(5).map((r) => ListTile(contentPadding: EdgeInsets.zero, leading: const CircleAvatar(child: Icon(Icons.monitor_weight)), title: Text('${r.weight.toStringAsFixed(2)} kg'), subtitle: Text(formatDate(r.date))))
    ])));
  }
}

